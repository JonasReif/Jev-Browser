TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional: fixed secret path segment for `jev-mcp --http`. Random per start when unset.
JEV_MCP_TOKEN=
# Optional: the only folder whose files the agent may upload. Default: ~/JevUploads
JEV_UPLOAD_DIR=
